# Copy this file to .env and fill it in.

PORT=3000

# --- Instagram (optional; only needed for `npm run refresh`) ---
# Uses Meta's official Instagram Graph API "Business Discovery" endpoint,
# which reads public posts of other Business/Creator accounts by username.
# You need: a Meta app, an Instagram Business or Creator account linked to a
# Facebook Page, and a long-lived user access token with instagram_basic +
# pages_show_list permissions.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v26.0

# How many recent posts to pull per shop on each refresh.
IG_POSTS_PER_SHOP=12
